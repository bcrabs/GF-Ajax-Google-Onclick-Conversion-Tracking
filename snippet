<?php
/**
 * Google Conversion Tracking for Gravity Forms Ajax Submissions
 * 
 * @package CRFTD
 * @author  CRFTD
 * @since   1.0.0
 * 
 * Description: Triggers Google conversion tracking on Gravity Forms Ajax submissions.
 * Assumes gtag_report_conversion() is already available in the page header.
 */

// Prevent direct access
if ( ! defined( 'ABSPATH' ) ) {
    exit;
}

/**
 * Trigger Google conversion tracking on Gravity Forms Ajax submission
 */
add_action( 'wp_footer', 'crftd_trigger_conversion_on_gform_submit' );
function crftd_trigger_conversion_on_gform_submit() {
    // Only load on pages with Gravity Forms
    if ( ! class_exists( 'GFCommon' ) ) {
        return;
    }
    ?>
    <script>
    jQuery(document).ready(function($) {
        // Listen for Gravity Forms confirmation event (Ajax submissions)
        $(document).on('gform_confirmation_loaded', function(event, formId) {
            // Trigger Google conversion tracking
            if (typeof gtag_report_conversion === 'function') {
                gtag_report_conversion();
            }
        });
    });
    </script>
    <?php
}
